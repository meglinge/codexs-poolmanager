# docker compose settings for poolmanager (copy to .env)

# Image published by CI (GitHub Container Registry). IMAGE_TAG is only the
# fallback for a manual `docker compose up`; releases go through
# deploy/abctl.py (or the 部署 page), which pins immutable sha-<sha> tags per
# slot in deploy/state/images.json.
IMAGE=ghcr.io/meglinge/codexs-poolmanager
IMAGE_TAG=latest

# Secrets: generate with `poolmanager gen-secret` or `openssl rand -hex 32`.
PM_ADMIN_TOKEN=change-me-admin
PM_RUNNER_TOKEN=change-me-runner
POSTGRES_PASSWORD=change-me-postgres
# Deployment control service token (treat as root; >= 16 chars). The managers
# use it to proxy the 部署 page; abctl.py reads it from this file.
PM_DEPLOY_TOKEN=change-me-deploy

# Absolute path of this compose directory on the host (the deployment
# container mounts the repo at the same path). Defaults to $PWD.
#DEPLOY_ROOT=/home/me/codexs-poolmanager
# Optional: GitHub token so the version list can show commit subjects for
# images built before CI stamped them into labels.
#PM_GITHUB_TOKEN=
# Host docker credentials file for private registries (default ~/.docker/config.json).
#DOCKER_CONFIG_JSON=

# Public gateway port (HAProxy), HAProxy stats port, HAProxy admin socket
# (host 127.0.0.1 only), deployment service port (host 127.0.0.1 only).
PUBLIC_PORT=8800
STATS_PORT=8404
PM_HAPROXY_ADMIN_PORT=8405
PM_DEPLOY_PORT=16828

# Seconds to wait for a slot to become ready / for the old slot's streams to
# drain after a switch (abctl never kills in-flight streams; on timeout it
# stops at the cutover stage and `resume` keeps waiting).
DEPLOY_TIMEOUT=600
DEPLOY_DRAIN_WAIT=1800

RUST_LOG=info,sqlx=warn
COMPOSE_SUBNET=10.250.0.0/24
